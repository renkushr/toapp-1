APP_NAME="To-app"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://to-app.com
APP_TIMEZONE=UTC

# Same Docker host — separate public portals
ADMIN_PORTAL_URL=https://tonkow.com
ADMIN_PORTAL_PATH=adto-app
AGENT_PORTAL_URL=https://agto-app.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=toapp
DB_USERNAME=toapp
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="To-app"

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
