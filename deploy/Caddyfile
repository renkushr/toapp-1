to-app.com, www.to-app.com {
	encode zstd gzip
	reverse_proxy app:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
	}
}

check-insure.com {
	redir https://www.check-insure.com{uri} permanent
}

www.check-insure.com {
	encode zstd gzip

	# Homepage opens Check Insure portal
	redir / /check-insure 302

	reverse_proxy app:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
	}
}

